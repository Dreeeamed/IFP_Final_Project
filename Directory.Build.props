    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <Authors>Ardak Kazykhan, Bolatbek Bolat</Authors>
  </PropertyGroup>
</Project>
