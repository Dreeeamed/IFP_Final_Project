@typeparam TItem
@* Generic templated table: the caller describes the header and each row as templates. *@
@if (Items.Count == 0)
{
    <div class="empty">@(Empty ?? DefaultEmpty)</div>
}
else
{
    <div class="table-wrap">
        <table class="data-table">
            <thead><tr>@Header</tr></thead>
            <tbody>
                @foreach (var item in Items)
                {
                    <tr>@Row(item)</tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private static readonly RenderFragment DefaultEmpty = builder => builder.AddContent(0, "Nothing here yet.");

    [Parameter, EditorRequired] public IReadOnlyList<TItem> Items { get; set; } = [];

    [Parameter, EditorRequired] public RenderFragment Header { get; set; } = default!;

    [Parameter, EditorRequired] public RenderFragment<TItem> Row { get; set; } = default!;

    [Parameter] public RenderFragment? Empty { get; set; }
}
