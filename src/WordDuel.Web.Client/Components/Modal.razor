@* Templated dialog: callers supply the title, body and footer as RenderFragments. *@
@if (Open)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal card" role="dialog" aria-modal="true" aria-labelledby="modal-title" @onclick:stopPropagation="true">
            <h2 id="modal-title">@Title</h2>
            <div class="modal__body">@ChildContent</div>
            @if (Footer is not null)
            {
                <div class="modal__footer">@Footer</div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }

    [Parameter] public RenderFragment? Title { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public RenderFragment? Footer { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private Task Close() => OnClose.InvokeAsync();
}
