@page "/how-to-play"

<PageTitle>How to play — Word Duel</PageTitle>

<section class="rules">
    <header class="page-head">
        <p class="eyebrow">Rules</p>
        <h1>How to play Word Duel</h1>
        <p class="muted">Two players, one secret word, two private boards.</p>
    </header>

    <div class="card">
        <HowToPlay />
    </div>

    <div class="card">
        <h3>Starting a duel</h3>
        <ol>
            <li>Enter a nickname and press <b>Create private room</b>.</li>
            <li>Send the six-character room code (or the invite link) to your opponent.</li>
            <li>Your opponent enters the code on their own device and presses <b>Join duel</b>. The first round starts immediately.</li>
        </ol>
        <p class="muted">Lost connection? Reload the page — your seat is kept for a minute and you can continue where you left off.</p>
        <a class="btn btn--primary" href="">Start playing</a>
    </div>
</section>
