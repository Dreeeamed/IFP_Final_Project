@page "/not-found"

<PageTitle>Not found — Word Duel</PageTitle>

<div class="center-card card">
    <div class="room-code" aria-hidden="true">
        <WordTile Letter="'4'" State="LetterState.Absent" Index="0" Animate="true" />
        <WordTile Letter="'0'" State="LetterState.Present" Index="1" Animate="true" />
        <WordTile Letter="'4'" State="LetterState.Absent" Index="2" Animate="true" />
    </div>
    <h1>That page isn't in the word list</h1>
    <p class="muted">The address may be mistyped, or the room has expired.</p>
    <a class="btn btn--primary" href="">Back to the arena</a>
</div>
