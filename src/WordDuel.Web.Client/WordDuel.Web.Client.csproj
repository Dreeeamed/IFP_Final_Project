<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- Blazor WebAssembly UI: runs in the browser and talks to the server only through the SignalR hub. -->
  <PropertyGroup>
    <RootNamespace>WordDuel.Web.Client</RootNamespace>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WordDuel.Core\WordDuel.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.15" />
  </ItemGroup>

</Project>
